{
  "name": "@francisvarga/temps-otel-dash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenTelemetry dashboard for Temps: OTLP/HTTP trace ingest, services, spans and trace waterfalls",
  "author": "Francis Varga",
  "license": "Apache-2.0",
  "repository": "https://github.com/FrancisVarga/temps-proj-otel-dash",
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit",
    "embed": "bun scripts/embed-assets.ts",
    "build": "bun run embed && bun build src/index.ts --compile --outfile dist/temps-otel-dash-plugin",
    "build:host": "bun build src/index.ts --compile --target=bun-linux-x64-musl-baseline --outfile dist/linux-amd64-musl/plugin"
  },
  "dependencies": {
    "@temps-sdk/plugin": "0.1.0-beta.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.3",
    "typescript": "5.9.3"
  },
  "temps": {
    "name": "otel-dash",
    "title": "OpenTelemetry Dashboard",
    "category": "Development",
    "entrypoint": "src/index.ts",
    "platforms": [
      "linux-amd64-gnu",
      "linux-arm64-gnu",
      "linux-amd64-musl",
      "linux-arm64-musl",
      "darwin-amd64",
      "darwin-arm64"
    ]
  }
}
